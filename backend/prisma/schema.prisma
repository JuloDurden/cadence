generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(DEV)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  // Phase 2.5 (roadmap v1), Onboarding, points 2-4 (tooltips progressifs, checklist, démo
  // interactive) — voir routes/onboarding.ts. `onboardingSeenAt` déclenche l'ouverture automatique
  // du panneau "Guide de démarrage" une seule fois, à la 1re connexion d'un compte réellement
  // nouveau (null par défaut à la création). La migration backfille les comptes déjà existants
  // avec `createdAt` pour ne jamais faire apparaître le panneau par surprise à un compte déjà
  // rodé. `onboardingCompletedItems` : ids des lignes de checklist cochées (voir
  // data/onboardingChecklist.ts côté frontend), coché automatiquement quand l'action réelle
  // correspondante est détectée (pas de déclaratif manuel "j'ai fait ça").
  onboardingSeenAt         DateTime?
  onboardingCompletedItems String[]  @default([])

  @@map("users")
}

model WorkspaceState {
  id        String   @id @default(cuid())
  data      Json
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspace_state")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// Phase 2.5 (roadmap v1) — Onboarding, brique "création de compte" : un Admin invite un
// Stakeholder (seul rôle accessible par invitation, voir routes/invitations.ts) en générant un
// lien à usage unique (token) à partager manuellement — pas d'infrastructure d'envoi d'email dans
// ce prototype. `usedAt` marque l'invitation consommée (accept-invite) ; une invitation non
// utilisée peut être révoquée (DELETE /api/invitations/:id) par un Admin.
model Invitation {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  createdBy String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  // Phase 2.5 (roadmap v1), verrouillage Stakeholder — id du Client (WorkspaceState.data.clients,
  // pas de table dédiée) auquel le futur Stakeholder sera rattaché comme Contact plutôt que comme
  // fiche Équipe (voir lib/teamState.ts, createLinkedClientContact). Nullable pour ne pas casser
  // les invitations déjà en base avant ce changement (une seule, déjà utilisée, chez Julien) ;
  // requis côté API pour toute nouvelle invitation (voir routes/invitations.ts).
  clientId  String?

  @@map("invitations")
}

// Phase 3 (roadmap v1), Mode présentation — lien de partage public (sans authentification) qui
// ouvre directement le mode présentation (Dashboard, Roadmap, Vision/NNL, Sprint Review, sidebar
// masquée, navigation clavier ←/→ — voir routes/presentation.ts). Contrairement à Invitation, pas
// de `usedAt` : ce lien est réutilisable (ouvert plusieurs fois par plusieurs visiteurs), pas à
// usage unique. Un seul lien actif à la fois dans ce prototype (routes/presentation.ts supprime
// l'ancien avant d'en créer un nouveau) — plus simple qu'une vraie liste, cohérent avec le
// singleton WorkspaceState : il n'y a qu'un seul workspace à présenter.
model PresentationLink {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  createdBy String
  createdAt DateTime @default(now())

  @@map("presentation_links")
}

// Phase 5 (roadmap v1), MCP Claude (Cadence) : jetons d'accès personnels (PAT), un par
// utilisateur/usage ("Claude Desktop", "MCP local"...), decision Julien (2026-08-08) : reutiliser
// l'auth existante plutot qu'un token statique unique, pour que le MCP respecte les memes roles
// que le reste de l'app (Admin/PO/etc.) plutot qu'un acces tout ou rien. Le jeton lui-meme est un
// JWT signe classique (meme `fastify.jwt.sign`, memes claims id/email/role que la connexion
// normale), longue duree plutot que les 8h d'une session ; seul `jti` est stocke en base, jamais
// le jeton en clair (impossible de le reafficher apres coup, meme UX que passwordHash). `jti`
// permet la revocation malgre le JWT stateless : `authenticate()` (middleware/auth.ts) verifie ce
// jeton en base UNIQUEMENT quand le payload en porte un (un jeton de session normal n'a pas de
// jti, donc aucun cout supplementaire sur le flux de connexion existant).
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  name       String
  jti        String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@map("api_tokens")
}

// Phase 5 (roadmap v1), Integration GitHub, 2026-08-08 : config d'un seul depot lie au workspace
// (singleton, meme principe que WorkspaceState/PresentationLink - un seul workspace Cadence dans
// ce prototype). Le jeton (Personal Access Token GitHub, cote repo/organisation, pas personnel a
// un compte Cadence) n'est JAMAIS renvoye en clair par l'API une fois enregistre (voir
// routes/github.ts) : seul un apercu tronque est expose pour verification visuelle, meme logique
// que le jeton en clair d'ApiToken (jamais reaffiche apres coup, mais ici parce qu'on en a besoin
// cote serveur pour appeler l'API GitHub, donc stocke en clair en base plutot que hache - meme
// posture que JWT_SECRET dans backend/.env, ce prototype ne chiffre aucun secret au repos).
// Gestion reservee Admin (secret d'organisation, pas personnel comme un jeton MCP).
model GitHubConfig {
  id        String   @id @default(cuid())
  owner     String
  repo      String
  token     String
  updatedAt DateTime @updatedAt

  @@map("github_config")
}

// Phase 5 (roadmap v1), Integration Slack, 2026-08-08 : config d'un seul workspace Slack lie au
// workspace Cadence (singleton, meme principe que GitHubConfig ci-dessus). Jeton Bot d'une vraie
// Slack App (xoxb-...), pas un webhook entrant : choisi par Julien (AskUserQuestion) pour pouvoir
// poster dans plusieurs canaux au choix plutot qu'un seul canal fixe. Meme posture que
// GitHubConfig : jeton en clair jamais renvoye par l'API une fois enregistre, stocke en clair en
// base (pas de chiffrement des secrets au repos dans ce prototype).
//
// 3 notifications independantes (perimetre acte avec Julien), chacune avec son propre canal et son
// propre interrupteur : cloture de sprint, "bloquants" (statut Kanban Bloque ET items dont une
// dependance n'est pas terminee a l'activation d'un sprint - les 2 partagent le meme canal/
// interrupteur, decision Julien de les regrouper sous un seul perimetre "alertes bloquants/
// dependances"), et resume Daily (envoye via un bouton manuel, PAS automatique a chaque saisie -
// decision Julien, pour eviter un message par membre a chaque entree individuelle).
model SlackConfig {
  id        String   @id @default(cuid())
  botToken  String
  teamName  String?

  sprintCloseChannelId   String?
  sprintCloseChannelName String?
  sprintCloseEnabled     Boolean @default(false)

  blockedChannelId   String?
  blockedChannelName String?
  blockedEnabled     Boolean @default(false)

  dailyChannelId   String?
  dailyChannelName String?
  dailyEnabled     Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@map("slack_config")
}

// Phase 2 (roadmap v1) — roles specifiques Cadence, remplace l'ancien trio generique
// ADMIN/MEMBER/VIEWER (voir docs/roadmap-v1.md, sous-chantier 1). PO/SCRUM_MASTER/DEV/
// STAKEHOLDER portent les permissions fines des sous-chantiers suivants ; ADMIN reste
// un role a part, superviseur (gestion des comptes, tags de base, etc.).
enum Role {
  ADMIN
  PO
  SCRUM_MASTER
  DEV
  STAKEHOLDER
}
